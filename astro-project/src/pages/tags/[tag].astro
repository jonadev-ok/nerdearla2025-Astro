---
export const prerender = true;
import LayoutBlog from "../../layouts/LayoutBlog.astro";
import BlogArticle from "../../components/blog/BlogArticle.astro";

interface Post {
  url: string;
  frontmatter: {
    title: string;
    pubDate: string;
    tags: string[];
    description: string;
  };
}

interface Props {
  posts: Post[];
  tag: string;
}

export function getStaticPaths(): { params: { tag: string }; props: Props }[] {
  const allPosts = Object.entries(
    import.meta.glob("../content/*.md", { eager: true }),
  ).map(([path, post]: any) => ({
    ...post,
    url: "/content/" + path.split("/").pop()?.replace(".md", ""),
  })) as Post[];

  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.frontmatter.tags))];

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts
        .filter((post) => post.frontmatter.tags.includes(tag))
        .sort(
          (a, b) =>
            new Date(b.frontmatter.pubDate).getTime() -
            new Date(a.frontmatter.pubDate).getTime(),
        ),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<LayoutBlog pageTitle={tag}>
  <main class="tag-results" id="inicio">
    <div class="tag-results-heading">
      <span class="blog-orbit-mark" aria-hidden="true">✳</span>
      <h1>Entradas etiquetadas con {tag}</h1>
    </div>
    <div class="blog-grid">
      {posts.map((post) => (
        <BlogArticle
          url={post.url}
          title={post.frontmatter.title}
          pubDate={post.frontmatter.pubDate}
          tags={post.frontmatter.tags}
          description={post.frontmatter.description}
        />
      ))}
    </div>
  </main>
</LayoutBlog>

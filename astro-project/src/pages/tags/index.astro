---
import LayoutBlog from "../../layouts/LayoutBlog.astro";

const allPosts = Object.values(
  import.meta.glob("../content/*.md", { eager: true }),
);
const tags = [
  ...new Set(allPosts.map((post: any) => post.frontmatter.tags).flat()),
];
const pageTitle = "Índice de etiquetas";
---

<LayoutBlog pageTitle={pageTitle}>
  <main class="tags-index" id="inicio">
    <h1>{pageTitle}</h1>
    <div class="tags-list">
      {tags.map((tag: string) => (
        <a class="blog-tag" href={`/tags/${tag}`}>{tag}</a>
      ))}
    </div>
  </main>
</LayoutBlog>

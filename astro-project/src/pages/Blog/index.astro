---
import LayoutBlog from "../../layouts/LayoutBlog.astro";
import Hero from "../../components/sections/Hero.astro";

const message = {
  firstMessage: "Bienvenid@ a nuestro blog!",
  secondMessage: "Volvés a nuestro blog, revisa nuestras novedades!",
};

const rawPosts = Object.values(
  import.meta.glob("../content/*.md", { eager: true }),
);

const allPosts = [...rawPosts].sort(
  (a: any, b: any) =>
    new Date(b.frontmatter.pubDate).getTime() -
    new Date(a.frontmatter.pubDate).getTime(),
);
---

<LayoutBlog>
  <main role="main">
    <Hero
      title="Bienvenidos a "
      span="Nuestro Blog"
      description="Aqui vas a encontrar diversos articulos que te ayudaran a entender que es lo que necesita tu negocio para crecer"
      url="#articles"
      cta="Explora nuestros articulos"
      bgImage="/backgrounds/bg-galaxy.webp"
      message={message}
    />
    <section id="articles" class="blog-feed">
      <div class="blog-feed-heading">
        <span class="blog-orbit-mark" aria-hidden="true">✳</span>
        <span class="blog-feed-rule"></span>
      </div>
      <div class="blog-grid">
        {allPosts.map((post: any, index: number) => (
          <article class:list={["blog-card", `blog-card-${index + 1}`]}>
            <span class="blog-card-index" aria-hidden="true">0{index + 1}</span>
            <h2><a href={post.url}>{post.frontmatter.title}</a></h2>
            <div class="blog-card-meta">
              <span>📅 {post.frontmatter.pubDate}</span>
              {post.frontmatter.tags.map((tag: any) => (
                <a href={`/tags/${tag}`} class="blog-tag">{tag}</a>
              ))}
            </div>
            <p>{post.frontmatter.description + "..."}</p>
            <a href={post.url} class="blog-read">Leer más <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </section>
  </main>
</LayoutBlog>

---
interface NavItem {
  title: string;
  label: string;
  url: string;
}

interface Props {
  logo: string;
  logoAlt?: string;
  brand: string;
  highlight: string;
  navItems: NavItem[];
  githubUrl?: string;
  isFixed?: boolean;
}

const {
  logo,
  logoAlt = "Logo",
  brand,
  highlight,
  navItems,
  githubUrl,
  isFixed = true,
} = Astro.props;

const { pathname } = Astro.url;
---

<header class:list={["site-header", { "is-fixed": isFixed }]}>
  <div class="header-inner">
    <a class="brand-lockup" href="/" aria-label={`${brand} ${highlight}`}>
      <img src={logo} alt={logoAlt} />
      <span class="brand-name">{brand}<b>{highlight}</b></span>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      {navItems.map((link) => {
        const isActive = link.url === "/" ? pathname === "/" : !link.url.startsWith("#") && pathname.startsWith(link.url);
        return (
          <a class:list={["nav-link", { active: isActive }]} aria-label={link.label} aria-current={isActive ? "page" : undefined} href={link.url}>
            <span>{link.title}</span>
          </a>
        );
      })}
    </nav>
    {githubUrl && (
      <a class="github-link" href={githubUrl} target="_blank" rel="noopener noreferrer" title="Visita el repositorio del proyecto">
        <img src="/logos/GitHubLogo.svg" alt="GitHub Repo" />
      </a>
    )}
    <details class="mobile-menu">
      <summary aria-label="Abrir menú"><span></span><span></span></summary>
      <nav aria-label="Navegación móvil">
        {navItems.map((link) => <a href={link.url}>{link.title}<span aria-hidden="true">↗</span></a>)}
      </nav>
    </details>
  </div>
</header>

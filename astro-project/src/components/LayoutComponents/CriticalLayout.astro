<style is:inline>
  :root { --first-paint-space: #0a0d18; --first-paint-paper: #f0eee7; --first-paint-orange: #ff5d01; --first-paint-serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif; }
  html, body { margin: 0; min-width: 320px; background: var(--first-paint-space); }
  body { color: var(--first-paint-paper); font-family: Inter, "Avenir Next", Avenir, ui-sans-serif, system-ui, sans-serif; }
  .site-header { position: absolute; z-index: 30; inset: 0 0 auto; height: 84px; }
  .site-header.is-fixed { position: fixed; }
  .header-inner { width: min(1320px, calc(100% - 72px)); height: 100%; margin: 0 auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 32px; }
  .brand-lockup { display: flex; align-items: center; gap: 10px; }
  .brand-lockup img { width: 24px; height: 34px; object-fit: contain; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(21px, 3vw, 42px); }
  .github-link { justify-self: end; display: grid; place-items: center; width: 36px; height: 36px; }
  .github-link img { width: 17px; height: 17px; }
  .hero-shell { position: relative; isolation: isolate; width: 100%; min-height: 760px; padding: 145px max(36px, calc((100vw - 1230px) / 2)) 75px; display: flex; align-items: center; overflow: hidden; background-color: var(--first-paint-space); background-position: center; background-repeat: no-repeat; background-size: cover; }
  .hero-frame { position: relative; width: min(1230px, 100%); min-height: 495px; margin: 0 auto; display: grid; grid-template-columns: minmax(400px, 1fr) minmax(360px, .9fr); align-items: center; }
  .hero-copy { position: relative; z-index: 2; padding: 20px 0 34px; text-align: left; }
  .hero-copy h1 { max-width: 720px; margin: 0; font-family: var(--first-paint-serif); font-size: clamp(62px, 8vw, 112px); font-weight: 400; letter-spacing: -.072em; line-height: .94; }
  .hero-copy h1 span { display: block; color: var(--first-paint-orange); font-family: var(--first-paint-serif); }
  .hero-description { width: min(590px, 100%); margin: 30px 0 26px; font-size: clamp(15px, 1.5vw, 18px); line-height: 1.75; }
  .hero-art { position: relative; width: min(46vw, 580px); aspect-ratio: 1; justify-self: end; display: grid; place-items: center; }
  .hero-planet { position: absolute; width: 41%; aspect-ratio: 1; border-radius: 50%; }
  .hero-orbit { position: absolute; width: 92%; height: 34%; border-radius: 50%; transform: rotate(-29deg); }
  .orbit-tight { width: 77%; height: 22%; transform: rotate(24deg); }
  #message { width: fit-content; max-width: 100%; min-height: 34px; box-sizing: border-box; }
  .content-section { position: relative; padding: 110px max(36px, calc((100vw - 1230px) / 2)); overflow: hidden; }
  .section-heading-block { max-width: 720px; margin: 0 auto 54px; text-align: center; }
  .services-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .service-card { min-height: 265px; }
  .project-gallery-grid { width: min(1120px, 100%); margin: 0 auto; display: grid; grid-template-columns: 1.3fr .7fr; grid-template-rows: repeat(2, minmax(170px, 230px)); gap: 12px; }
  .project-gallery-image { width: 100%; height: 100%; min-height: 0; object-fit: cover; }
  .project-gallery-image:first-child { grid-row: span 2; }
  .blog-grid { width: min(1180px, 100%); margin: 0 auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; }
  .site-footer { min-height: 104px; }
  .footer-inner { width: min(1230px, calc(100% - 72px)); min-height: 104px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
  @media (max-width: 900px) {
    .header-inner { width: calc(100% - 44px); grid-template-columns: 1fr auto; }
    .desktop-nav { gap: 20px; }
    .github-link { display: none; }
    .hero-shell { min-height: 720px; padding-inline: 32px; }
    .hero-frame { grid-template-columns: minmax(350px, 1fr) minmax(280px, .8fr); }
    .hero-art { width: min(42vw, 430px); }
    .content-section { padding-inline: 32px; }
  }
  @media (max-width: 680px) {
    .site-header { height: 70px; }
    .header-inner { width: calc(100% - 34px); grid-template-columns: 1fr auto; }
    .brand-lockup img { width: 20px; height: 29px; }
    .desktop-nav, .github-link { display: none; }
    .mobile-menu { display: block; position: relative; justify-self: end; }
    .mobile-menu summary { display: flex; width: 41px; height: 39px; flex-direction: column; justify-content: center; gap: 6px; padding: 10px; }
    .hero-shell { min-height: 850px; padding: 112px 22px 48px; align-items: flex-start; }
    .hero-frame { min-height: 0; grid-template-columns: 1fr; align-content: start; }
    .hero-copy { padding: 20px 0 0; }
    .hero-copy h1 { max-width: 520px; font-size: clamp(59px, 16vw, 82px); }
    .hero-description { margin: 21px 0 22px; font-size: 14px; }
    .hero-art { width: min(84vw, 370px); margin: 7px auto 0; justify-self: center; }
    #message { margin-top: 23px; }
    .content-section { padding: 77px 22px; }
    .services-grid { grid-template-columns: 1fr; }
    .service-card { min-height: 0; }
    .project-gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 220px 140px; gap: 8px; }
    .project-gallery-image:first-child { grid-column: span 2; grid-row: auto; }
    .blog-grid { grid-template-columns: 1fr; gap: 11px; }
    .footer-inner { width: calc(100% - 38px); min-height: 125px; align-items: flex-start; flex-direction: column; justify-content: center; gap: 11px; padding-block: 20px; }
  }
</style>

---
const { title, url, pubDate, tags, description } = Astro.props;
---

<article class="blog-card">
  <h2><a href={url}>{title}</a></h2>
  <div class="blog-card-meta">
    📅 {pubDate}
    {tags.map((tag: string) => (
      <a href={`/tags/${tag}`} class="blog-tag">{tag}</a>
    ))}
  </div>
  <p>{description}</p>
  <a href={url} class="blog-read">Leer más <span aria-hidden="true">→</span></a>
</article>

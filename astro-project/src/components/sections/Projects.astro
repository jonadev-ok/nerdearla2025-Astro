---
import ProjectGallery from "../islands/ProjectGallery";
import TitleContainer from "../ui/TitleContainer.astro";
import ParagraphContainer from "../ui/ParagraphContainer.astro";
import Project from "../../icons/icons-ui/Project.astro";

const images = [
  { src: "/projects/project01.webp", alt: "Proyecto 1" },
  { src: "/projects/project02.webp", alt: "Proyecto 2" },
  { src: "/projects/project03.webp", alt: "Proyecto 3" },
];
---

<section id="projects" class="content-section projects-section">
  <div class="section-heading-block">
    <span class="section-ornament" aria-hidden="true"><Project class="w-10 h-10 pr-2" /></span>
    <TitleContainer headingLevel="h2" className="section-title">Nuestros Proyectos</TitleContainer>
    <ParagraphContainer>Aqui vas a encontrar los proyectos de los clientes que confiaron en nosotros.</ParagraphContainer>
  </div>
  <ProjectGallery images={images} client:load />
</section>

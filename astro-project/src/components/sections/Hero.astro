---
import Message from "../ui/Message.astro";
import ParagraphContainer from "../ui/ParagraphContainer.astro";
import SectionContainer from "./SectionContainer.astro";

const { title, span, description, url, cta, bgImage, message } = Astro.props;
---

<SectionContainer id="home" bgImage={bgImage}>
  <div class="hero-frame">
    <div class="hero-copy">
      <h1>{title}<span>{span}</span></h1>
      <ParagraphContainer>{description}</ParagraphContainer>
      <a href={url} class="hero-cta">{cta}<span aria-hidden="true">↗</span></a>
      <Message {...message} />
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="hero-constellation constellation-one"></div>
      <div class="hero-constellation constellation-two"></div>
      <div class="hero-orbit orbit-wide"><span></span></div>
      <div class="hero-orbit orbit-tight"><span></span></div>
      <div class="hero-planet"></div>
      <img class="hero-mark" src="/logos/Astro_light.svg" alt="" />
      <span class="hero-cross cross-one">✳</span>
      <span class="hero-cross cross-two">✧</span>
    </div>
    <span class="hero-coordinate" aria-hidden="true">A / 01</span>
  </div>
</SectionContainer>

---
import TitleContainer from "../ui/TitleContainer.astro";
import ParagraphContainer from "../ui/ParagraphContainer.astro";
import Card from "../ui/Card.astro";
import StarServicesIcon from "../../icons/icons-ui/StarServicesIcon.astro";
const cardServices = [
  {
    title: "Desarrollo web",
    description:
      "Diseñamos y desarrollamos sitios web atractivos, rápidos y seguros para destacar tu marca, optimizar conversiones y mejorar la experiencia del usuario.",
    link: "mailto:contacto@astrodevs.com?subject=Consulta%20sobre%20Desarrollo%20web",
    btnText: "Saber mas →",
  },
  {
    title: "Gestión y mantenimiento",
    description:
      "Nos ocupamos de la actualización, seguridad y rendimiento de tu sitio, asegurando que funcione sin fallos y siempre esté optimizado para tus clientes.",
    link: "mailto:contacto@astrodevs.com?subject=Consulta%20sobre%20Gestión%20y%20mantenimiento",
    btnText: "Saber mas →",
  },
  {
    title: "Marketing digital",
    description:
      "Creamos estrategias de marketing digital efectivas para aumentar tu visibilidad online, atraer clientes potenciales y potenciar tus resultados de venta.",
    link: "mailto:contacto@astrodevs.com?subject=Consulta%20sobre%20Marketing%20digital",
    btnText: "Saber mas →",
  },
];
---

<section id="services" class="content-section services-section">
  <div class="section-heading-block">
    <span class="section-ornament" aria-hidden="true"><StarServicesIcon class="w-10 h-10 pr-2" /></span>
    <TitleContainer headingLevel="h2" className="section-title">Nuestros servicios</TitleContainer>
    <ParagraphContainer>Aqui vas a encontrar todos nuestros servicios</ParagraphContainer>
  </div>
  <div class="services-grid">
    {
      cardServices.map((c: any) => (
        <Card
          title={c.title}
          description={c.description}
          link={c.link}
          btnText={c.btnText}
        />
      ))
    }
  </div>
</section>

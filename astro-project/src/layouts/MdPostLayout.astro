---
import LayoutBlog from "./LayoutBlog.astro";
import ShareButtons from "../components/islands/ShareButtons";

const { frontmatter } = Astro.props;
const currentURL = Astro.site + Astro.url.pathname;
const title = frontmatter.title;
---

<LayoutBlog title={frontmatter.title}>
  <article class="post-shell" id="inicio">
    <h1 class="post-heading">{frontmatter.title}</h1>
    <ul class="post-meta">
      <li>📅{frontmatter.pubDate}</li>
      <li class="post-tags">
        {frontmatter.tags.map((tag: string) => (
          <a href={`/tags/${tag}`} class="blog-tag">{tag}</a>
        ))}
      </li>
    </ul>
    <div class="post-content"><slot /></div>
    <div class="post-share"><ShareButtons url={currentURL} title={title} client:load /></div>
  </article>
</LayoutBlog>
